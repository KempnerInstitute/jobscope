  DHDR = ("NODE", "GPU", "CPU%", "CPU-MEM", "GPU%", "GPU-MEM", "GMEM%",
          "SM_ACT%", "OCC%", "TENSOR%", "DRAM%", "POWER_W", "DIAG")

  def dline(cells):
    return " ".join(c[1].format(str(cells[c[3]])) for c in dcols)

  def rows_for(jid, d):
    rows = blob_detail(d.get('js'))
    if do_dcgm:
      per_gpu = dcgm_data.get(jid, ({}, {}))[1]
      rows = [extend_detail_row(r, per_gpu, d.get('dur'), args.min_runtime, args.diagnose)
              for r in rows]
    return rows

  # CSV: per-(job,node,GPU) rows, identifiable by a leading JOBID column.
  if args.csv:
    writer = csv.writer(sys.stdout, lineterminator='\n')
    if args.header:
      for label, val in context_pairs(args, desc, data):
        writer.writerow([label, val])
      writer.writerow(["JOBID"] + [c[0] for c in dcols])
    for jid in jobids:
      d = data.get(jid, {})
      for r in rows_for(jid, d):
        writer.writerow([jid] + [r[c[3]] for c in dcols])
    return

  if args.header:
    for label, val in context_pairs(args, desc, data):
      print(fmt_context(label, val))
    print()
  if not jobids:
    print("(no GPU jobs in this selection)")
    return
  for jid in jobids:
    d = data.get(jid, {})
    print(f"Job {jid}  [{d.get('state', '?')}]  {d.get('name', '?')}")
    rows = rows_for(jid, d)
    if not rows:
      print("  (no jobstats data)\n"); continue
    print("  " + dline(DHDR))
    print("  " + "-" * len(dline(DHDR)))
    for r in rows:
      print("  " + dline(r))
    print()


def dcgm_report(jobids, args, desc, data, dcgm_data, specs):
  """--dcgm view: per-GPU DCGM profiling table, ONE ROW PER GPU (no averaged
  'Overall' row, no DIAG). Consumes dcgm_data[jid]=(overall, per_gpu); uses
  per_gpu only. Restricted to GPU jobs (matching the --gpu summary)."""
  jobids = [j for j in jobids if data.get(j, {}).get('gpus')]
  headers = [s[1] for s in specs]

  def gkey(nm):   # sort per_gpu keys (node, minor_str) by node then numeric minor
    return (nm[0], _gpu_minor_key(nm[1]))

  # CSV: one row per (job, node, GPU), leading JOBID like the -d view.
  if args.csv:
    writer = csv.writer(sys.stdout, lineterminator='\n')
    if args.header:
      for label, val in context_pairs(args, desc, data):
        writer.writerow([label, val])
      writer.writerow(["JOBID", "STATE", "NAME", "NODE", "GPU", "DUR_S"] + headers)
    for jid in jobids:
      d = data.get(jid, {})
      per_gpu = dcgm_data.get(jid, ({}, {}))[1]
      for nm in sorted(per_gpu, key=gkey):
        vals = per_gpu[nm]
        writer.writerow([jid, d.get('state', '?'), d.get('name', '?'), nm[0], nm[1],
                         d.get('dur', '')] + [fmt_spec(s, vals.get(s[1])) for s in specs])
    return

  if args.header:
    for label, val in context_pairs(args, desc, data):
      print(fmt_context(label, val))
    print()
  if not jobids:
    print("(no GPU jobs in this selection)")
    return

  DHDR = ["NODE", "GPU"] + headers
  widths = [16, 4] + [max(len(h), 8) + 1 for h in headers]

  def line(cells):
    return " ".join(str(c).ljust(w) for c, w in zip(cells, widths))

  for jid in jobids:
    d = data.get(jid, {})
    win = ""
    if d.get('start'):
      win = "   (%s .. %s, %ds)" % (
          time.strftime('%Y-%m-%d %H:%M', time.localtime(d['start'])),
          time.strftime('%H:%M', time.localtime(d['end'])), d.get('dur') or 0)
    print(f"Job {jid}  [{d.get('state', '?')}]  {d.get('name', '?')}{win}")
    per_gpu = dcgm_data.get(jid, ({}, {}))[1]
    if not per_gpu:
      print("  (no GPU samples for this job -- too short, no DCGM data, or beyond retention)\n")
      continue
    if args.header:
      print("  " + line(DHDR))
      print("  " + "-" * len(line(DHDR)))
    for nm in sorted(per_gpu, key=gkey):
      vals = per_gpu[nm]
      print("  " + line([nm[0], nm[1]] + [fmt_spec(s, vals.get(s[1])) for s in specs]))
    print()


def dcgm_timeseries(jobids, data, specs, args, timeout):
  """--dcgm --ts: emit the RAW per-scrape DCGM time series over the job's window
  as CSV (one row per GPU/timestamp), instead of the window average. Restricted to
  a single job by the caller. Metrics are de-duplicated by Prometheus name (so
  POWER_W/PWRmax_W collapse to one column); each cell is the raw sampled value,
  scaled for display."""
  seen, tspecs = set(), []
  for s in specs:                       # dedupe by prometheus metric name
    if s[2] not in seen:
      seen.add(s[2]); tspecs.append(s)
  sp = prom_setup()['sp']
  w = csv.writer(sys.stdout, lineterminator='\n')
  if args.header:
    w.writerow(["JOBID", "EPOCH", "TIME", "NODE", "GPU"] + [s[1] for s in tspecs])

  def cell(v, dec):
    if v is None:
      return ''
    return ("{:.%df}" % dec).format(v) if dec else str(int(round(v)))

  for jid in jobids:
    d = data.get(jid, {})
    gpus = discover_gpus(d, timeout)
    if not gpus:
      print("warn: job %s has no GPU samples" % jid, file=sys.stderr); continue
    uuid_to = {g['uuid']: (g['node'], g['minor']) for g in gpus}
    rx = "^(" + "|".join(uuid_to) + ")$"
    # keep range/step under Prometheus' ~11k-point cap for long jobs
    step = max(sp, d['dur'] // 10000 + 1)
    series = {u: {} for u in uuid_to}   # {uuid: {ts: {header: value}}}
    for key, header, metric, uuidlbl, reducer, scale, dec, agg, group in tspecs:
      for r in prom_query_range("%s{%s=~\"%s\"}" % (metric, uuidlbl, rx),
                                d['start'], d['end'], step, timeout):
        u = r['metric'].get(uuidlbl) or r['metric'].get('uuid') or r['metric'].get('UUID')
        if u not in series:
          continue
        for ts, val in r['values']:
          try:
            series[u].setdefault(int(ts), {})[header] = float(val) * scale
          except (TypeError, ValueError):
            pass
    rows = []                           # (node, minor_sort, ts, csv_row)
    for u, (node, minor) in uuid_to.items():
      for ts in sorted(series[u]):
        cells = series[u][ts]
        rows.append((node, _gpu_minor_key(minor), ts,
                     [jid, ts, time.strftime('%Y-%m-%dT%H:%M:%S', time.localtime(ts)),
                      node, minor] + [cell(cells.get(s[1]), s[6]) for s in tspecs]))
    for _, _, _, row in sorted(rows, key=lambda x: (x[0], x[1], x[2])):
      w.writerow(row)


if __name__ == "__main__":
  desc = (
  """
  kempner_jobstats  (companion to stotal_kempner / seff_history)
  -----------------

  Compact per-job utilization summary (CPU%/MEM%/GPU%/GMEM%), computed in BULK
  from each job's sacct AdminComment blob -- ONE sacct query, no per-job jobstats
  calls and no job-count cap. For completed jobs the numbers match `jobstats`.
  Selects the user's jobs (default $USER), optionally narrowed by -A/account,
  -p/partition and -t/state, over a time scope (-N last N jobs, -D last N days,
  -S/-E window). With no scope at all it defaults to the last 1 day. Give explicit
  JOBIDs to bypass selection.
  Pick columns with --cpu/--gpu/--cgpu (default --gpu); -d adds the per-node/GPU
  breakdown. The --gpu view also pulls time-averaged DCGM profiling columns
  (SM_ACT%/OCC%/TENSOR%/DRAM%/POWER_W) live from the jobstats Prometheus (one
  extra set of queries per GPU job, GPU jobs only). --gpu --diagnose adds an
  advisory DIAG column (idle/underfed/low-occ/mem-bound/no-tensor/ok) from the
  same data. --cpu (CPU only) and --cgpu (CPU+GPU) stay blob-only and offline --
  use --cgpu for a fast, network-free overview. --csv works for the summary and
  -d views.
  --dcgm switches to a per-GPU DCGM profiling table (one row per GPU):
  DUTY%/SM_ACT%/OCC%/TENSOR%/DRAM%/POWER_W by default, --ext for the full 28-metric
  catalog. --dcgm --csv emits one CSV row per job/GPU; --dcgm --ts emits the raw
  per-scrape time series for a single job (one JOBID). --dcgm otherwise follows
  the same job selection as above.
  -----------------
  """
  )
  parser = argparse.ArgumentParser(formatter_class=argparse.RawDescriptionHelpFormatter,
                                   description=desc)
  parser.add_argument("jobids", nargs="*", help="specific job IDs (bypass time selection)")
  parser.add_argument("-u", "--user", dest="user", default=None, help="user (default: current user, $USER)")
  parser.add_argument("-A", "--account", dest="account", default=None, help="narrow to this account")
  parser.add_argument("-p", "--partition", dest="partition", default=None, help="narrow to this partition")
  parser.add_argument("-t", "--state", dest="state", choices=["all", "completed", "failed"],
                      default="all", help="job state filter (default: all; completed/failed default to -D 1)")
  parser.add_argument("-N", "--lastn", dest="lastn", type=int, default=None, help="the most recent N jobs")
  parser.add_argument("-D", "--days", dest="days", type=int, default=None, help="jobs in the last N days")
  parser.add_argument("-S", "--starttime", dest="starttime", default=None, help="window start (sacct format)")
  parser.add_argument("-E", "--endtime", dest="endtime", default=None, help="window end (sacct format)")
  parser.add_argument("-d", "--details", dest="details", action="store_true", help="per-node / per-GPU breakdown")
  mg = parser.add_mutually_exclusive_group()
  mg.add_argument("--cpu", action="store_const", const="cpu", dest="metrics", help="CPU columns only (offline)")
  mg.add_argument("--gpu", action="store_const", const="gpu", dest="metrics",
                  help="GPU columns -- blob (GPU%%/GMEM%%) plus time-averaged DCGM profiling "
                       "(SM_ACT%%/OCC%%/TENSOR%%/DRAM%%/POWER_W) pulled live from Prometheus (default)")
  mg.add_argument("--cgpu", action="store_const", const="cgpu", dest="metrics",
                  help="both CPU and GPU blob columns (offline; no DCGM/Prometheus)")
  parser.add_argument("--dcgm", dest="dcgm", action="store_true",
                      help="per-GPU DCGM profiling table (one row per GPU, pulled live from "
                           "Prometheus): DUTY%%/SM_ACT%%/OCC%%/TENSOR%%/DRAM%%/POWER_W. Its own view -- "
                           "overrides --cpu/--gpu/--cgpu and -d. Add --ext for the full 28-metric catalog")
  parser.add_argument("--ext", "--extended", dest="ext", action="store_true",
                      help="with --dcgm, show the full extended metric catalog (ENGINE/HMMA/IMMA/DFMA/"
                           "FP16/FP32/FP64/MEMCP/PWRmax/ENERGY/FB_*/PCIE_*/NVLINK/clocks/temps/ENC/DEC)")
  parser.add_argument("--ts", "--timeseries", dest="ts", action="store_true",
                      help="with --dcgm, emit the RAW per-scrape time series over the job's window as "
                           "CSV (JOBID,EPOCH,TIME,NODE,GPU,<metrics>) instead of the window average; "
                           "one job at a time (pass exactly one JOBID)")
  parser.add_argument("--workers", dest="workers", type=int, default=8,
                      help="max concurrent DCGM Prometheus query-sets for the --gpu view (default 8; "
                           "the queries are I/O-bound so >1 helps even on a single CPU). Use 1 to serialize")
  parser.add_argument("--diagnose", dest="diagnose", action="store_true",
                      help="add an advisory DIAG column (idle/underfed/low-occ/mem-bound/no-tensor/ok) "
                           "to the --gpu view, derived from the DCGM metrics (implies --gpu)")
  parser.add_argument("--min-runtime", dest="min_runtime", type=int, default=180,
                      help="jobs shorter than this many seconds get DIAG=short (default 180; sampling noise)")
  parser.add_argument("--describe", "--description", "--explain", dest="describe", action="store_true",
                      help="print a plain-English description of each column and exit (no job needed; "
                           "add --diagnose for the DIAG legend, or --dcgm [--ext] for the DCGM catalog)")
  parser.add_argument("-n", "--noheader", dest="header", action="store_false", help="suppress the header/context block")
  parser.add_argument("--csv", dest="csv", action="store_true", help="machine-readable output (summary, -d, or --dcgm view)")
  parser.add_argument("--timeout", dest="timeout", type=float, default=60.0,
                      help="seconds per sacct call (default 60; 0 disables)")
  args = parser.parse_args()

  # --ext/--ts are modifiers of --dcgm only.
  if (args.ext or args.ts) and not args.dcgm:
    parser.error("--ext/--ts only apply with --dcgm")

  if args.describe:   # static reference; no sacct/Prometheus, no job selection
    if args.dcgm:
      describe_dcgm(ALL_SPECS if args.ext else DEFAULT_SPECS)
    else:
      describe(args)
    sys.exit(0)

  # The raw time series is meant for plotting one job's profile, so restrict it to
  # a single explicit JOBID -- not a (potentially many-job) time/account selection.
  if args.ts and len(args.jobids) != 1:
    parser.error("--dcgm --ts profiles one job at a time: pass exactly one JOBID")

  # Defaults and validation (mirroring stotal_kempner).
  if args.user is None:
    args.user = default_user()
    if not args.user:
      parser.error("could not determine the current user from $USER; pass -u/--user")
  # Default to the last 1 day when no time scope (-N/-D/-S/-E) or JOBIDs is given.
  if args.lastn is None and args.days is None \
     and not args.starttime and not args.endtime and not args.jobids:
    args.days = 1
  if args.days is not None:
    if args.days <= 0:
      parser.error("-D/--days must be a positive integer")
    if args.lastn is not None:
      parser.error("-D/--days cannot be combined with -N/--lastn")
    if args.starttime or args.endtime:
      parser.error("-D/--days sets the window; do not also pass -S/-E")
    args.starttime, args.endtime = days_to_window(args.days)
  if args.lastn is not None and args.lastn <= 0:
    parser.error("-N/--lastn must be a positive integer")

  # --dcgm is its own per-GPU view: it overrides --cpu/--gpu/--cgpu and -d, and
  # never carries DIAG (DIAG stays on the --gpu summary only).
  if args.dcgm:
    if args.metrics is not None:
      print("note: --dcgm overrides --cpu/--gpu/--cgpu", file=sys.stderr)
    if args.details:
      print("note: --dcgm is already per-GPU; ignoring -d", file=sys.stderr)
    args.diagnose = False
    args.metrics = 'gpu'        # GPU-bearing, so the fetch path + GPU-job filter apply
    args.show_dcgm = True
    dcgm_specs = ALL_SPECS if args.ext else DEFAULT_SPECS
  else:
    # Metric columns: --cpu/--gpu/--cgpu, default --gpu (the GPU view with DCGM).
    if args.metrics is None:
      args.metrics = 'gpu'
    # DIAG lives in the --gpu view only (the only one that touches Prometheus);
    # ignore --diagnose elsewhere with a note.
    if args.metrics != 'gpu' and args.diagnose:
      print("note: --diagnose applies only to the --gpu view; ignoring", file=sys.stderr)
      args.diagnose = False
    # The DCGM columns are shown/fetched only in the --gpu view.
    args.show_dcgm = (args.metrics == 'gpu')
    dcgm_specs = GPU_SUMMARY_SPECS

  if args.workers < 1:
    parser.error("--workers must be a positive integer")

  timeout = args.timeout if args.timeout and args.timeout > 0 else None

  jobids, sel_desc = select_jobs(args, timeout)

  if not jobids:
    print(f"No matching jobs for user '{args.user}' ({sel_desc}).", file=sys.stderr)
    sys.exit(0)

  data = fetch(jobids, timeout)  # ONE bulk sacct query; no per-job calls

  # DCGM is the only network path. --dcgm --ts does its own range queries; every
  # other DCGM path uses the concurrent window-average fetch. cpu/cgpu skip it.
  if args.dcgm:
    if args.ts:
      dcgm_timeseries(jobids, data, dcgm_specs, args, timeout)
    else:
      dcgm_data = compute_dcgm(jobids, data, dcgm_specs, timeout, args.workers)
      dcgm_report(jobids, args, sel_desc, data, dcgm_data, dcgm_specs)
  else:
    dcgm_data = compute_dcgm(jobids, data, dcgm_specs, timeout, args.workers) if args.show_dcgm else {}
    if args.details:
      detail(jobids, args, sel_desc, data, dcgm_data)
    else:
      summarize(jobids, args, sel_desc, data, dcgm_data)
