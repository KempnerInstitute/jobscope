def cols_for(specs, view, dcgm=False, diagnose=False):
    """Column specs to show for the chosen metric view (cpu / gpu / cgpu).
    The DCGM columns are part of the --gpu view; the DIAG column is added by
    --diagnose. Both live in the --gpu view only (it is the only one that pulls
    DCGM); --cpu/--cgpu are blob-only and offline."""
    out = []
    for c in specs:
        g = c[2]
        if g == 'id' \
           or (g == 'cpu' and view in ('cpu', 'cgpu')) \
           or (g == 'gpu' and view in ('gpu', 'cgpu')) \
           or (g == 'dcgm' and dcgm and view == 'gpu') \
           or (g == 'diag' and diagnose and view == 'gpu'):
            out.append(c)
    return out


# --- AdminComment blob decoding & metrics ------------------------------------
# The jobstats data is stored per job in sacct's AdminComment as "JS1:<base64 gzip
# JSON>". The JSON has nodes[node]{total_time(cpu-sec), cpus, used_memory,
# total_memory, gpu_utilization{}, gpu_used_memory{}, gpu_total_memory{}} and a
# top-level total_time(elapsed). jobstats computes its numbers from exactly this.
def get_stats_dict(ss64):
  s = str(ss64)
  if (not ss64) or s in ('JS1:Short', 'JS1:None') or not s.startswith('JS1:'):
    return {}
  try:
    return json.loads(gzip.decompress(base64.b64decode(s[4:])))
  except Exception:
    return {}

def gpu_from_tres(s):
  """Number of GPUs from an AllocTRES string (gres/gpu=N)."""
  m = re.search(r'gres/gpu=(\d+)', str(s))
  return int(m.group(1)) if m else 0

def gb(b):
  """Bytes -> GiB string labelled GB (matching jobstats), trailing zeros trimmed."""
  return f"{b / GIB:.1f}".rstrip('0').rstrip('.') + "GB"

def blob_metrics(js):
  """Overall (cpu%, mem%, gpu%, gmem%) for a job, or None if the blob is empty.
  gpu%/gmem% are None for CPU-only jobs. Matches jobstats's overall bars."""
  if not js or 'nodes' not in js:
    return None
  nodes = list(js['nodes'].values())
  rt = js.get('total_time', 0) or 0
  cput = sum(n.get('total_time', 0) for n in nodes)
  cpus = sum(n.get('cpus', 0) for n in nodes)
  cpu = 100 * cput / (rt * cpus) if rt and cpus else 0
  um = sum(n.get('used_memory', 0) for n in nodes)
  tm = sum(n.get('total_memory', 0) for n in nodes)
  mem = 100 * um / tm if tm else 0
  gut = [v for n in nodes for v in n.get('gpu_utilization', {}).values()]
  gpu = sum(gut) / len(gut) if gut else None
  gum = sum(v for n in nodes for v in n.get('gpu_used_memory', {}).values())
  gtm = sum(v for n in nodes for v in n.get('gpu_total_memory', {}).values())
  gmem = 100 * gum / gtm if gtm else None
  return (round(cpu), round(mem),
          round(gpu) if gpu is not None else None,
          round(gmem) if gmem is not None else None)

def blob_detail(js):
  """Per-node / per-GPU rows (node, gpu, cpu%, cpu-mem, gpu%, gpu-mem, gmem%),
  matching jobstats's Detailed Utilization layout."""
  rows = []
  if not js or 'nodes' not in js:
    return rows
  rt = js.get('total_time', 0) or 0
  for nd, n in js['nodes'].items():
    cpus = n.get('cpus', 0)
    eff = 100 * n.get('total_time', 0) / (rt * cpus) if rt and cpus else 0
    cmem = f"{gb(n.get('used_memory', 0))}/{gb(n.get('total_memory', 0))}"
    gutil, gused, gtot = (n.get('gpu_utilization', {}), n.get('gpu_used_memory', {}),
                          n.get('gpu_total_memory', {}))
    if gutil or gtot:
      for g in sorted(gutil or gtot, key=str):
        used, tot = gused.get(g, 0), gtot.get(g, 0)
        gmp = 100 * used / tot if tot else 0
        rows.append((nd, str(g), f"{eff:.1f}%", cmem,
                     f"{gutil.get(g, 0):g}%", f"{gb(used)}/{gb(tot)}", f"{gmp:.1f}%"))
    else:
      rows.append((nd, '-', f"{eff:.1f}%", cmem, '-', '-', '-'))
  return rows


