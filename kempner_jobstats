#!/usr/bin/python3
# kempner_jobstats - compact per-job utilization summary (CPU%/MEM%/GPU%/GMEM%),
# same table as jobstats_summary but computed in BULK from each job's sacct
# AdminComment blob (the data jobstats itself stores) -- ONE sacct query, no
# per-job `jobstats` calls and no job-count cap. For completed jobs the metrics
# match `jobstats` exactly (it decodes the same blob); running jobs may differ by
# ~1% since jobstats re-reads live data while the blob is the last snapshot.
#
# Jobs are selected for the user (default $USER), optionally narrowed by account
# (-A) and/or partition (-p) and/or state (-t), over a time scope:
#   - explicit JOBID(s)        -> exactly those jobs
#   - -N/--lastn N             -> the most recent N jobs
#   - -D/--days N              -> jobs in the last N days
#   - -S/-E                    -> jobs in an explicit window
#   - -t completed/failed      -> that state (over the window / default last day)
#   - (nothing)                -> the last 1 day
#
# Author: Bala Desinghu, Senior AI/HPC Research Computing Engineer, Kempner Institute, Harvard

import os, sys, re, signal, subprocess, getpass, time, argparse, csv, json, gzip, base64
from concurrent.futures import ThreadPoolExecutor

PATTERN = '%Y-%m-%dT%H:%M:%S'
GIB = 1073741824


def default_user():
  """Current user from $USER, falling back to getpass; None if undeterminable."""
  u = os.environ.get("USER")
  if not u:
    try:
      u = getpass.getuser()
    except Exception:
      u = None
  return u


def days_to_window(days):
  """(start, end) sacct timestamps for the last `days` days ending now."""
  now = time.time()
  return (time.strftime(PATTERN, time.localtime(now - days * 86400)),
          time.strftime(PATTERN, time.localtime(now)))


def fmt_context(label, val):
  """A '  Label:     value' context line."""
  return f"  {label + ':':<11}{val}"


def run_capture(cmd, timeout, what, soft=False):
  """Run cmd, capture stdout, hard timeout (process-group kill so a child holding
  the pipe cannot hang us). timeout=None disables it. soft=True returns None on
  timeout/non-zero instead of aborting (used for per-job jobstats)."""
  try:
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            universal_newlines=True, start_new_session=True)
  except FileNotFoundError:
    sys.exit(f"ERROR: command not found: {cmd[0]}")
  try:
    out, err = proc.communicate(timeout=timeout)
  except subprocess.TimeoutExpired:
    try:
      os.killpg(proc.pid, signal.SIGKILL)
    except OSError:
      proc.kill()
    try:
      proc.communicate(timeout=5)
    except Exception:
      pass
    if soft:
      return None
    sys.exit(
        f"ERROR: {what} timed out after {timeout:g}s -- the selection likely spans too\n"
        f"many jobs for sacct to return in time. Narrow it (in increasing order of help):\n"
        f"  -N N             fewer jobs   -- your most recent N (e.g. -N 50)\n"
        f"  -D N             fewer days   -- the last N days     (e.g. -D 3)\n"
        f"  -S DATE -E DATE  a narrow explicit window (best) -- e.g.\n"
        f"                   -S 2026-05-26 -E 2026-06-02\n"
        f"Or raise/disable the cap with --timeout SECONDS (--timeout 0 disables it).")
  if proc.returncode != 0:
    if soft:
      return None
    sys.exit(f"ERROR: {what} failed (exit {proc.returncode}): {(err or '').strip()}")
  return out


