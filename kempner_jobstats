def prom_setup():
  """Lazily import PROM_SERVER/SAMPLING_PERIOD/requests from the jobstats install.
  Only called when the --gpu view fetches DCGM, so cpu/full/blob-only use never
  needs them."""
  if _PROM:
    return _PROM
  for p in ("/usr/local/bin", "/usr/bin"):
    if p not in sys.path:
      sys.path.append(p)
  try:
    from config import PROM_SERVER
  except Exception as e:
    sys.exit("ERROR: the --gpu view needs the jobstats `config` (PROM_SERVER): %s\n"
             "       Run this where the `jobstats` command lives, or use the offline --cgpu view." % e)
  try:
    from config import SAMPLING_PERIOD as sp
  except Exception:
    sp = 60
  try:
    import requests
  except Exception:
    sys.exit("ERROR: the --gpu view needs the `requests` module (it ships with jobstats); "
             "or use the offline --cgpu view.")
  _PROM.update(server=PROM_SERVER, sp=sp, req=requests)
  return _PROM


def epoch(s):
  """sacct timestamp -> int epoch; 'Unknown'/'' -> None."""
  if not s or s == "Unknown":
    return None
  try:
    return int(time.mktime(time.strptime(s, PATTERN)))
  except Exception:
    return None


def prom_query(query, at, timeout):
  """Instant query at epoch `at`; returns the result list (raises on error)."""
  P = prom_setup()
  r = P['req'].get(P['server'] + '/api/v1/query',
                   params={'query': query, 'time': at}, timeout=timeout)
  j = r.json()
  if j.get('status') != 'success':
    raise RuntimeError(j.get('error', 'prometheus query failed'))
  return j['data']['result']


def prom_query_range(query, start, end, step, timeout):
  """Range query -> result list, each series carrying raw [ts, value] samples at
  `step` resolution over [start, end]. Empty on error. Used by --dcgm --ts."""
  P = prom_setup()
  r = P['req'].get(P['server'] + '/api/v1/query_range',
                   params={'query': query, 'start': start, 'end': end, 'step': step},
                   timeout=timeout)
  j = r.json()
  return j['data']['result'] if j.get('status') == 'success' else []


def _dcgm_query(metric, reducer, uuidlbl, uuids, dur):
  rx = "^(" + "|".join(uuids) + ")$"   # UUIDs are hex+hyphen, RE2-safe as-is
  sel = "%s{%s=~\"%s\"}" % (metric, uuidlbl, rx)
  if reducer == 'avg':
    return "avg_over_time((%s)[%ds:])" % (sel, dur)
  if reducer == 'max':
    return "max_over_time((%s)[%ds:])" % (sel, dur)
  return "(max_over_time((%s)[%ds:]) - min_over_time((%s)[%ds:]))" % (sel, dur, sel, dur)


def _gpu_minor_key(minor):
  """Numeric sort key for a GPU minor number; falls back to string."""
  return int(minor) if str(minor).isdigit() else minor


def discover_gpus(d, timeout):
  """[{uuid,node,minor}] for the GPUs that ran the job over its window, sorted by
  (node, numeric minor). [] for CPU-only jobs or when no GPU samples exist. Joins
  via nvidia_gpu_jobId -- the same job->GPU mapping jobstats uses. (Used by the
  --dcgm --ts path; the window-average path discovers inline in dcgm_for_job.)"""
  if not d.get('gpus') or not d.get('jobidraw') or not d.get('dur'):
    return []
  cl = "slurm_cluster='%s'" % d['cluster'] if d.get('cluster') else ''
  try:
    disc = prom_query("max_over_time((nvidia_gpu_jobId{%s} == %s)[%ds:])"
                      % (cl, d['jobidraw'], d['dur']), d['end'], timeout)
  except Exception:
    return []
  gpus = []
  for s in disc:
    m = s['metric']
    u = m.get('uuid')
    if u:
      gpus.append({'uuid': u, 'node': m.get('host', '?').split(':')[0],
                   'minor': str(m.get('minor_number', '?'))})
  gpus.sort(key=lambda g: (g['node'], _gpu_minor_key(g['minor'])))
  return gpus


def dcgm_for_job(d, specs, timeout):
  """(overall{header:val}, per_gpu{(node,minor):{header:val}}) for one job over
  the given metric `specs`, or ({},{}) when it has no GPUs / no samples. Joins
  DCGM series to the job on UUID via nvidia_gpu_jobId (jobstats's mapping)."""
  if not d.get('gpus') or not d.get('jobidraw') or not d.get('dur'):
    return {}, {}
  try:
    cl = "slurm_cluster='%s'" % d['cluster'] if d.get('cluster') else ''
    disc = prom_query("max_over_time((nvidia_gpu_jobId{%s} == %s)[%ds:])"
                      % (cl, d['jobidraw'], d['dur']), d['end'], timeout)
  except Exception:
    return {}, {}
  gpus, uuids = [], []
  for s in disc:
    m = s['metric']
    u = m.get('uuid')
    if u:
      gpus.append((m.get('host', '?').split(':')[0], str(m.get('minor_number', '?')), u))
      uuids.append(u)
  if not uuids:
    return {}, {}
  per_uuid = {u: {} for u in uuids}
  for key, header, metric, uuidlbl, reducer, scale, dec, agg, group in specs:
    try:
      res = prom_query(_dcgm_query(metric, reducer, uuidlbl, uuids, d['dur']),
                       d['end'], timeout)
    except Exception:
      continue
    for s in res:
      u = s['metric'].get(uuidlbl) or s['metric'].get('uuid') or s['metric'].get('UUID')
      try:
        if u in per_uuid:
          per_uuid[u][header] = float(s['value'][1]) * scale
      except (TypeError, ValueError):
        pass
  per_gpu = {(node, minor): per_uuid.get(u, {}) for node, minor, u in gpus}
  overall = {}
  for key, header, metric, uuidlbl, reducer, scale, dec, agg, group in specs:
    vals = [per_uuid[u][header] for u in uuids if header in per_uuid[u]]
    if vals:
      overall[header] = (sum(vals) if agg == 'sum'
                         else max(vals) if agg == 'max'
                         else sum(vals) / len(vals))
  return overall, per_gpu


def fmt_spec(spec, v):
  """Format one DCGM cell ('-' when missing), using the metric's decimals (spec[6])."""
  if v is None:
    return '-'
  dec = spec[6]
  return ("{:.%df}" % dec).format(v) if dec else str(int(round(v)))


def dcgm_fmt(header, v):
  """Format a DCGM cell by header (summary/detail callers); see fmt_spec."""
  return fmt_spec(SPEC_BY_HEADER[header], v)


# --- diagnosis (opt-in via --diagnose) ---------------------------------------
# Advisory tags from the 4 DCGM utilization metrics (no extra queries beyond the
# --gpu view's DCGM fetch). Heuristic and window-averaged, so a
# multi-phase job blurs; descriptive, not a verdict. Several legitimately-low-util
# workloads (inference, sampling, sparse HPC, data prep) read as "underfed"
# without being wasteful -- confirm against intent. Thresholds are percent
# (SM_ACT/OCC/TENSOR/DRAM are 0-100).
DIAG_IDLE, DIAG_UNDERFED, DIAG_BUSY = 5, 15, 40
DIAG_LOWOCC, DIAG_MEM, DIAG_TENSOR = 20, 40, 1

DIAG_LEGEND = """\
DIAG -- advisory tag(s) from the utilization metrics (heuristic, not a verdict;
window-averaged, so multi-phase jobs blur). Several legitimately-low-util
workloads (inference, sampling, sparse HPC, data prep) read as "underfed".
  idle       SM_ACT < %d%%                    GPU essentially never ran a kernel
  underfed   SM_ACT < %d%%                   resident but cores mostly idle (host/input bound)
  low-occ    SM_ACT >= %d%%, OCC < %d%%        SMs busy but warp slots underfilled
  mem-bound  DRAM >= %d%% and >= SM_ACT       HBM bandwidth is the limiter
  no-tensor  SM_ACT >= %d%%, TENSOR < %d%%       tensor cores idle (e.g. fp32 ML)
  ok         SM_ACT >= %d%%, none of above    healthy compute use
  short      ran under --min-runtime         averages are sampling noise""" % (
    DIAG_IDLE, DIAG_UNDERFED, DIAG_BUSY, DIAG_LOWOCC, DIAG_MEM,
    DIAG_BUSY, DIAG_TENSOR, DIAG_BUSY)


def diagnose(smact, occ, tensor, dram, dur, min_runtime):
  """One or more advisory tags from SM_ACT%/OCC%/TENSOR%/DRAM% (each 0-100, or
  None if unavailable). Comma-joined; 'short' if the job ran under min_runtime,
  '-' when there is no clear signal or no data. Tags: idle / underfed / low-occ
  / mem-bound / no-tensor / ok."""
  if dur is not None and min_runtime and dur < min_runtime:
    return "short"
  if smact is None:
    return "-"
  if smact < DIAG_IDLE:
    return "idle"
  if smact < DIAG_UNDERFED:
    return "underfed"
  tags = []
  if occ is not None and smact >= DIAG_BUSY and occ < DIAG_LOWOCC:
    tags.append("low-occ")
  if dram is not None and dram >= DIAG_MEM and dram >= smact:
    tags.append("mem-bound")
  if tensor is not None and smact >= DIAG_BUSY and tensor < DIAG_TENSOR:
    tags.append("no-tensor")
  if not tags and smact >= DIAG_BUSY:
    tags.append("ok")
  return ",".join(tags) if tags else "-"


def diag_from_dcgm(dvals, dur, min_runtime):
  """Diagnose one GPU (or the overall dict) from a {header: value} DCGM dict."""
  return diagnose(dvals.get('SM_ACT%'), dvals.get('OCC%'), dvals.get('TENSOR%'),
                  dvals.get('DRAM%'), dur, min_runtime)


