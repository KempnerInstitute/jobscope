def extend_detail_row(r, per_gpu, dur=None, min_runtime=None, diagnose_on=False):
  """Append the DCGM cells (indices 7-11) and, with diagnose_on, the DIAG cell
  (index 12) to a blob_detail row, matched on (node, gpu)."""
  vals = per_gpu.get((r[0], str(r[1])), {})
  out = tuple(r) + tuple(dcgm_fmt(h, vals.get(h)) for h in DCGM_HEADERS)
  if diagnose_on:
    out = out + (diag_from_dcgm(vals, dur, min_runtime),)
  return out


def compute_dcgm(jobids, data, specs, timeout, workers):
  """Run dcgm_for_job over `specs` for every GPU job, concurrently -> {jid:
  (overall, per_gpu)}. The per-job queries are network I/O-bound (each thread
  mostly waits on the Prometheus round-trip; the GIL is released during that
  wait), so a thread pool overlaps them and speeds up wide selections even on a
  single CPU core. The per-metric queries *within* one job stay sequential --
  the parallelism is across jobs."""
  gpu_jids = [j for j in jobids if data.get(j, {}).get('gpus')]
  if not gpu_jids:
    return {}
  prom_setup()   # initialise the shared _PROM once, before any worker runs
  workers = max(1, min(workers, len(gpu_jids)))
  if workers == 1:
    return {j: dcgm_for_job(data[j], specs, timeout) for j in gpu_jids}
  results = {}
  with ThreadPoolExecutor(max_workers=workers) as ex:
    futs = {ex.submit(dcgm_for_job, data[j], specs, timeout): j for j in gpu_jids}
    for fut, j in futs.items():
      try:
        results[j] = fut.result()
      except Exception:
        results[j] = ({}, {})
  return results


# --- job selection & bulk fetch ----------------------------------------------
def select_jobs(args, timeout):
  """Return (jobids, description). Per-job data is fetched in bulk afterwards."""
  if args.jobids:
    return list(args.jobids), f"{len(args.jobids)} job ID(s)"

  # sacct query over a window. start/end are always set by the time it gets here:
  # an explicit -S/-E, -D, or the default last 1 day; -N uses a now-30days lookback.
  s = args.starttime or 'now-30days'
  e = args.endtime or 'now'
  cmd = ['sacct', '-u', args.user, '-X', '-S', s, '-E', e, '--noheader', '-P', '-o', 'JobID,State']
  if args.account:   cmd += ['-A', args.account]
  if args.partition: cmd += ['-r', args.partition]
  if args.state == 'completed': cmd += ['-s', 'COMPLETED']
  elif args.state == 'failed':  cmd += ['-s', FAILED_STATES]
  out = run_capture(cmd, timeout, "sacct query")
  ids = []
  for line in out.splitlines():
    parts = line.split('|', 1)
    if len(parts) == 2 and not parts[1].startswith('PENDING'):
      ids.append(parts[0])
  if args.lastn is not None:
    ids = ids[-args.lastn:]  # sacct lists ascending by jobid -> last N = most recent
  if args.lastn is not None:   desc = f"last {args.lastn} jobs"
  elif args.days is not None:  desc = f"last {args.days} day" + ("s" if args.days != 1 else "")
  else:                        desc = f"{s} .. {e}"
  if args.state != 'all':      desc += f", {args.state}"
  return ids, desc


def query_jobid(j):
  """JobID to pass to `sacct -j`. Array jobs cancelled/pending before expansion
  appear as 'BASE_[range%throttle]' (e.g. '18114115_[0-719%64]'); sacct -j cannot
  parse that element spec and dies with "Bad job array element specified", so query
  the base id instead -- it returns the very same record (keyed back as the bracket
  form). Plain ids and expanded tasks ('BASE_N') pass through unchanged."""
  return j.split('_', 1)[0] if '_[' in j else j


def fetch(jobids, timeout):
  """ONE bulk sacct query for all jobs -> {jid: {state,name,runtime,nodes,gpus,js}}.
  This replaces per-job `jobstats` calls; js is the decoded AdminComment blob."""
  data = {}
  if not jobids:
    return data
  qids, seen = [], set()  # de-bracket array ids (above); dedupe so a base isn't queried twice
  for j in jobids:
    q = query_jobid(j)
    if q not in seen:
      seen.add(q); qids.append(q)
  # AdminComment is the base64 blob (no '|'), so it stays last and we split with
  # a fixed maxsplit. Start/End/JobIDRaw/Cluster are only used by the --gpu view's
  # DCGM fetch; adding them keeps this a single bulk query.
  out = run_capture(['sacct', '-j', ','.join(qids), '-X', '-P', '-n', '--units=G',
                     '-o', 'JobID,State,JobName,Elapsed,NNodes,AllocTRES,'
                           'Start,End,JobIDRaw,Cluster,User,AdminComment'],
                    timeout, "sacct query")
  for line in out.splitlines():
    p = line.split('|', 11)
    if len(p) < 12:
      continue
    jid, state, name, elapsed, nnodes, alloctres, start, end, jidraw, cluster, user, admin = p
    s = epoch(start)
    e = epoch(end) or int(time.time())   # running job -> now
    data[jid] = {'state': (state.split() or ['?'])[0], 'name': name or '?',
                 'runtime': elapsed or '-', 'nodes': nnodes or '-',
                 'gpus': gpu_from_tres(alloctres), 'js': get_stats_dict(admin),
                 'start': s, 'end': e, 'dur': (max(e - s, 1) if s else None),
                 'jobidraw': jidraw, 'cluster': cluster, 'user': user or '?'}
  return data


# --- output ------------------------------------------------------------------
def context_pairs(args, desc, data=None):
  # With explicit JOBIDs, selection is bypassed -- the -u/-A/-p filters are NOT
  # applied, so echoing args.user (the default $USER) would be misleading. Show
  # the jobs' actual owner(s) from sacct instead, and drop the filter lines.
  if args.jobids:
    owners = sorted({d.get('user') for d in (data or {}).values() if d.get('user')})
    user_val = ", ".join(owners) if owners else "(explicit job IDs)"
    return [("User", user_val), ("Select", desc)]
  pairs = [("User", args.user)]
  if args.account:   pairs.append(("Account", args.account))
  if args.partition: pairs.append(("Partition", args.partition))
  pairs.append(("Select", desc))
  return pairs


def summarize(jobids, args, desc, data, dcgm_data):
  do_dcgm = args.show_dcgm   # DCGM is fetched (and shown) only in the --gpu view
  if args.metrics == 'gpu':   # GPU view -> only jobs that requested GPUs
    jobids = [j for j in jobids if data.get(j, {}).get('gpus')]
  cols = cols_for(SUMCOLS, args.metrics, args.show_dcgm, args.diagnose)
  headers = [c[0] for c in cols]
  ctx = context_pairs(args, desc, data)
  writer = csv.writer(sys.stdout, lineterminator='\n') if args.csv else None

  def line(rowd):
    return " ".join(c[1].format(str(rowd.get(c[0], ''))) for c in cols)

  if args.header:
    if args.csv:
      for label, val in ctx: writer.writerow([label, val])
      writer.writerow(headers)
    else:
      for label, val in ctx: print(fmt_context(label, val))
      hdr = line({c[0]: c[0] for c in cols})
      print(hdr)
      print("-" * len(hdr))

  if not jobids:
    if args.header and not args.csv:
      print("  (no GPU jobs in this selection)")
    return

  sums = {k: [0, 0] for k in ('cpu', 'mem', 'gpu', 'gmem')}  # [total, count]
  sums_d = {h: [0.0, 0] for h in DCGM_HEADERS}
  for jid in jobids:
    d = data.get(jid, {})
    rowd = {'JOBID': jid, 'STATE': d.get('state', '?'),
            'NODES': d.get('nodes', '-'), 'GPUS': str(d['gpus']) if d.get('gpus') else '-',
            'RUNTIME': d.get('runtime', '-'),
            'NAME': d.get('name', '(job not found)')}
    m = blob_metrics(d.get('js'))
    if m is None:
      for c in ('CPU%', 'MEM%', 'GPU%', 'GMEM%'):
        rowd[c] = '-'
    else:
      for k, col, v in zip(('cpu', 'mem', 'gpu', 'gmem'), ('CPU%', 'MEM%', 'GPU%', 'GMEM%'), m):
        rowd[col] = '-' if v is None else str(v)
        if v is not None:
          sums[k][0] += v; sums[k][1] += 1
    if do_dcgm:
      overall = dcgm_data.get(jid, ({}, {}))[0]
      for h in DCGM_HEADERS:
        v = overall.get(h)
        rowd[h] = dcgm_fmt(h, v)
        if v is not None:
          sums_d[h][0] += v; sums_d[h][1] += 1
      if args.diagnose:
        rowd['DIAG'] = diag_from_dcgm(overall, d.get('dur'), args.min_runtime)
    if args.csv:
      writer.writerow([rowd[h] for h in headers])
    else:
      print(line(rowd))

  # Mean row (unweighted mean of the % columns over jobs that reported them).
  if len(jobids) > 1:
    def mean(k):
      t, n = sums[k]
      return str(round(t / n)) if n else '-'
    mrowd = {c[0]: '' for c in SUMCOLS}
    mrowd['CPU%'], mrowd['MEM%'] = mean('cpu'), mean('mem')
    mrowd['GPU%'], mrowd['GMEM%'] = mean('gpu'), mean('gmem')
    if do_dcgm:
      for h in DCGM_HEADERS:
        t, n = sums_d[h]
        mrowd[h] = dcgm_fmt(h, t / n) if n else '-'
    if args.csv:
      mrowd['JOBID'] = 'Mean'
      writer.writerow([mrowd[h] for h in headers])
    else:
      mrowd['JOBID'] = 'Mean:'
      if args.header:
        print("-" * len(line({c[0]: c[0] for c in cols})))
      print(line(mrowd))


def detail(jobids, args, desc, data, dcgm_data):
  do_dcgm = args.show_dcgm   # DCGM is fetched (and shown) only in the --gpu view
  if args.metrics == 'gpu':   # GPU view -> only jobs that requested GPUs
    jobids = [j for j in jobids if data.get(j, {}).get('gpus')]
