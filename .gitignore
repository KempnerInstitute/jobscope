__pycache__/
*.pyc
*.sif
.DS_Store

# Virtual environments
.venv/
venv/
.venv*/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Local jobscope config (may hold Prometheus credentials): never commit it.
# Only config.example.toml is tracked.
config.toml
*.local.toml

# Local design notes kept out of the repo but on disk while a branch is in flight.
docs/superpowers/

# The pre-package script and its work log. Kept on disk for whoever still has the old
# command lines in a shell history, but not shipped: the logic moved into the package
# and the notes describe a layout the repo no longer has.
contrib/jobscope_live.py
contrib/jobscope_live_notes.md

# Output that names real users, accounts, jobs and hosts, and must never reach the remote.
# The sweep that wrote most of it now lives in the jobsweep repository, but its artifacts,
# store and logs are still on disk here under out/ -- and jobscope's own runner defaults to
# an out_dir of "out" relative to the working directory, so a run started from the
# repository still lands here.
out/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
