#!/usr/bin/env python3.12
# /// script
# requires-python = ">=3.12"
# dependencies = ["plotext>=5.3", "rich>=13"]
# ///
# (The block above lets `uv run jobstats_plot` auto-provision Python 3.12 +
# plotext + rich. It is a plain comment to a normal interpreter.)
#
# jobstats_plot - render kempner_jobstats CSV as terminal graphs.
#
# Reads the CSV that `kempner_jobstats` already emits and draws it: utilization
# bar gauges, a distribution histogram, a colored heatmap table, or a time-series
# line chart. This keeps plotting OUT of the core tool -- kempner_jobstats stays
# dependency-free and fast on its own interpreter; all the plotting deps (plotext
# + rich, Python 3.12) live here and are only paid for when you actually plot.
#
# The view is auto-detected from the CSV columns; override with --kind.
#   kempner_jobstats --gpu  --csv  -D 7      | jobstats_plot     # histogram (many jobs)
#   kempner_jobstats --gpu  --csv  JOBID     | jobstats_plot     # bar gauges (one job)
#   kempner_jobstats --dcgm --csv  JOBID...  | jobstats_plot     # heatmap (jobs/GPUs x metrics)
#   kempner_jobstats --dcgm --ts --csv JOBID | jobstats_plot     # time-series line + per-metric stats
#   jobstats_plot -f saved.csv --kind heat                       # from a saved file
#
# Author: Bala Desinghu, Senior AI/HPC Research Computing Engineer, Kempner Institute, Harvard

import os, sys, csv, shutil, argparse


def _bootstrap_venv():
  """Run jobstats_plot under the venv recorded in plot_util/venv_path.conf.

  jobstats_plot needs plotext + rich (the core scanner does not). Instead of a
  wrapper on PATH, the tool self-resolves: if those libs aren't importable in the
  current interpreter, read `venv_env_path` from venv_path.conf (next to this
  file) and re-exec under <venv_env_path>/.venv/bin/python. One hop, guarded
  against loops; a no-op when the libs are already present (e.g. `uv run`)."""
  if os.environ.get("_KJ_PLOT_BOOTSTRAP"):
    return                                    # already re-exec'd once -- don't loop
  import importlib.util
  try:
    if importlib.util.find_spec("plotext") and importlib.util.find_spec("rich"):
      return                                  # libs available here -> run in place
  except Exception:
    pass
  here = os.path.dirname(os.path.realpath(__file__))   # plot_util/ (follows symlinks)
  base = ""
  try:
    with open(os.path.join(here, "venv_path.conf")) as f:
      for line in f:
        line = line.strip()
        if line.startswith("venv_env_path="):
          base = line.split("=", 1)[1].strip()
  except OSError:
    pass
  if not base:
    base = "/n/holylfs06/LABS/kempner_shared/Everyone/cluster_scripts/job_eff/kempner-jobstats"
  for py in (os.path.join(base, ".venv", "bin", "python"),
             os.path.join(base, "bin", "python")):
    if os.access(py, os.X_OK):
      os.environ["_KJ_PLOT_BOOTSTRAP"] = "1"
      os.execv(py, [py, os.path.realpath(__file__), *sys.argv[1:]])
  # No venv python found: fall through; load_libs() prints an actionable message.


_bootstrap_venv()


# Columns that identify a row rather than carry a plottable metric.
ID_COLS = {"JOBID", "STATE", "NAME", "NODES", "GPUS", "NODE", "GPU",
           "DUR_S", "RUNTIME", "EPOCH", "TIME"}

# Red cutoff per %-metric (higher is better): value < RED -> red, < 2*RED -> yellow,
# else green. %-metrics not listed here use DEFAULT_RED. Non-% columns (POWER_W,
# *_GB, *_MHz, TEMP_C, ...) are shown as plain values, never graded. --config can
# override GPU%/GMEM%/CPU%/MEM% from the jobstats config.
DEFAULT_RED = 15          # DCGM utilization %: idle/underfed band (matches DIAG cutoffs)
RED = {"GPU%": 25, "DUTY%": 25, "GMEM%": 20, "CPU%": 25, "MEM%": 25}

HEAT_MAX_ROWS = 40
PANEL_CAP = 12            # max stacked --ts panels before capping (narrow with --node/--gpu)

# Distinct 256-color codes for the --ts chart, one per metric so each metric reads
# as its own color. Integer codes (not names) so the plotext line and the
# rich-tinted per-metric stats summary render the exact same color.
PALETTE = [196, 46, 33, 208, 201, 51, 226, 129, 244, 39]

# Time-series line chart: which metrics to draw by default (if present), unless
# --metric/--all widen it. Kept small so the chart stays readable.
TS_DEFAULT = ["SM_ACT%", "OCC%", "TENSOR%", "DRAM%"]

# Braille dot bits for the 1-row --compact sparkline (cell = 2 cols x 4 rows).
_BR_DOT = {(0, 0): 0x01, (0, 1): 0x02, (0, 2): 0x04, (0, 3): 0x40,
           (1, 0): 0x08, (1, 1): 0x10, (1, 2): 0x20, (1, 3): 0x80}


def braille_spark(vals, cells):
  """A one-row braille sparkline of vals over `cells` chars, scaled to vals' own
  min..max (top = high). Returns (sparkline, lo, hi); ('', None, None) if empty."""
  vals = [v for v in vals if v is not None]
  if not vals:
    return "", None, None
  lo, hi = min(vals), max(vals)
  rng = (hi - lo) or 1.0
  cells = max(1, cells)
  cols, n = cells * 2, len(vals)
  out = []
  for c in range(cells):
    ch = 0
    for sub in (0, 1):
      v = vals[min(n - 1, (c * 2 + sub) * n // cols)]
      row = 3 - int(round((v - lo) / rng * 3))   # 0 = top (high) .. 3 = bottom (low)
      ch |= _BR_DOT[(sub, row)]
    out.append(chr(0x2800 + ch))
  return "".join(out), lo, hi


def die(msg):
  sys.exit("ERROR: " + msg)


def load_libs():
  """Import plotext + rich on demand, with an actionable message if missing."""
  try:
    import plotext as plt
    from rich.console import Console
    from rich.table import Table
    from rich.text import Text
    return plt, Console, Table, Text
  except ImportError as e:
    die("jobstats_plot needs plotext and rich (missing: %s).\n"
        "       Build/point a venv: bash plot_util/setup/install_venv.sh\n"
        "       (or set venv_env_path in plot_util/venv_path.conf).\n"
        "       The core scanner needs none of this -- only plotting does."
        % getattr(e, "name", e))


def load_config_red():
  """Best-effort: pull GPU/MEM red cutoffs from the jobstats config (opt-in via
  --config). Never prints anything from the module (it holds a secret)."""
  for p in ("/usr/local/bin", "/usr/bin"):
    if p not in sys.path:
      sys.path.append(p)
  try:
    import config
  except Exception as e:
    die("--config: could not import the jobstats config: %s" % e)
  for key, attr in (("GPU%", "GPU_UTIL_RED"), ("GMEM%", "GPU_MEM_UTIL_RED"),
                    ("CPU%", "CPU_UTIL_RED"), ("MEM%", "CPU_MEM_UTIL_RED")):
    v = getattr(config, attr, None)
    if isinstance(v, (int, float)):
      RED[key] = v


# --- CSV parsing -------------------------------------------------------------
def parse_csv(fobj):
  """Return (columns, rows) from a kempner_jobstats CSV. Skips the leading context
  rows (User,.. / Select,..) up to the header row (first cell 'JOBID'), and drops
  the trailing 'Mean' summary row. rows are dicts keyed by column."""
  columns, rows = None, []
  for rec in csv.reader(fobj):
    if not rec:
      continue
    if columns is None:
      if rec[0] == "JOBID":           # the real header row
        columns = rec
      continue                        # still in the context block
    if rec[0] == "Mean":              # summary mean row -- not a job
      continue
    rows.append({columns[i]: (rec[i] if i < len(rec) else "") for i in range(len(columns))})
  if columns is None:
    die("no 'JOBID' header row found -- is this kempner_jobstats --csv output? "
        "(pipe without -n so the header is included)")
  return columns, rows


def to_float(s):
  """'-'/'' -> None; otherwise float, or None if unparseable."""
  if s is None or s in ("-", ""):
    return None
  try:
    return float(s)
  except ValueError:
    return None


def metric_cols(columns):
  """Plottable metric columns, in CSV order (everything that isn't an id column)."""
  return [c for c in columns if c not in ID_COLS]


def is_pct(header):
  return header.endswith("%")


def grade(header, v):
  """Color name for a %-metric value (rich/plotext share these names)."""
  if v is None or not is_pct(header):
    return "white"
  red = RED.get(header, DEFAULT_RED)
  if v < red:
    return "red"
  if v < 2 * red:
    return "yellow"
  return "green"


def detect_kind(columns):
  if "EPOCH" in columns and "TIME" in columns:
    return "line"
  if {"NODE", "GPU", "DUR_S"} <= set(columns):
    return "heat"
  return "summary"   # JOBID x metrics; bars (1 job) or hist (many)


# --- renderers ---------------------------------------------------------------
def render_bars(columns, rows, args, Console, Text):
  """Horizontal utilization gauges: one bar per %-metric (mean over rows if >1),
  threshold-colored; non-% metrics shown as plain values."""
  console = Console(no_color=args.no_color)
  mcols = metric_cols(columns)
  title = args.title or ("utilization" + (" (mean of %d jobs)" % len(rows) if len(rows) > 1 else
                         ("  %s" % rows[0].get("JOBID", "")) if rows else ""))
  console.print("[bold]%s[/bold]" % title) if not args.no_color else print(title)
  width = 34
  for c in mcols:
    vals = [to_float(r.get(c)) for r in rows]
    vals = [v for v in vals if v is not None]
    if not vals:
      continue
    v = sum(vals) / len(vals)
    if is_pct(c):
      filled = max(0, min(width, int(round(v / 100.0 * width))))
      t = Text()
      t.append("%9s " % c)
      t.append("█" * filled, style=grade(c, v))
      t.append("░" * (width - filled), style="grey37")
      t.append(" %5.1f%%" % v)
      console.print(t)
    else:
      console.print("%9s  %g" % (c, v))


def render_hist(columns, rows, args, plt):
  """Distribution of one metric across the selection (plotext histogram)."""
  mcols = [c for c in metric_cols(columns) if is_pct(c)]
  metric = args.metric or next((m for m in ("GPU%", "CPU%") if m in mcols), (mcols[0] if mcols else None))
  if not metric:
    die("no %%-metric column to histogram (try --metric)")
  if metric not in columns:
    die("metric %r not in CSV columns: %s" % (metric, ", ".join(metric_cols(columns))))
  vals = [to_float(r.get(metric)) for r in rows]
  vals = [v for v in vals if v is not None]
  if not vals:
    die("no numeric values for %s" % metric)
  plt.clear_figure()
  plt.theme("clear")
  if args.width and args.height:
    plt.plotsize(args.width, args.height)
  plt.hist(vals, bins=min(15, max(5, len(set(vals)))))
  plt.xlim(0, 100)
  plt.title(args.title or ("%s distribution (%d jobs)" % (metric, len(vals))))
  plt.xlabel(metric); plt.ylabel("jobs")
  plt.show()


def render_heat(columns, rows, args, Console, Table, Text):
  """Jobs (or GPUs) x metrics, cell background colored by value."""
  console = Console(no_color=args.no_color)
  mcols = metric_cols(columns)
  per_gpu = {"NODE", "GPU"} <= set(columns)
  label_hdr = "NODE:GPU" if per_gpu else "JOBID"
  capped = rows[:args.max_rows]
  base = "per-GPU metrics" if per_gpu else "per-job metrics"
  table = Table(title=args.title or (base + (" (first %d of %d)" % (args.max_rows, len(rows))
                                     if len(rows) > args.max_rows else "")),
                header_style="bold")
  table.add_column(label_hdr, no_wrap=True)
  for c in mcols:
    table.add_column(c, justify="right")
  for r in capped:
    label = ("%s:%s" % (r.get("NODE", "?"), r.get("GPU", "?"))) if per_gpu else r.get("JOBID", "?")
    cells = [label]
    for c in mcols:
      raw = r.get(c, "-")
      v = to_float(raw)
      if v is not None and is_pct(c) and not args.no_color:
        cells.append(Text(raw, style="black on %s" % grade(c, v)))
      else:
        cells.append(raw)
    table.add_row(*cells)
  console.print(table)
  if len(rows) > args.max_rows:
    print("note: showing %d of %d rows; narrow the selection or raise --max-rows"
          % (args.max_rows, len(rows)), file=sys.stderr)


def render_line(columns, rows, args, plt, Console):
  """Time-series line chart over the job's window + a per-metric stats summary.
  x = minutes since the first sample. By default each GPU gets one panel with all
  metrics on a shared axis (--by gpu); --by metric gives one panel per metric
  (own y-axis, avoids overlap), and --compact gives one sparkline row per metric.
    single GPU          -> one panel, all metrics (--by metric: one per metric)
    one node, many GPUs -> one panel per GPU (--by metric: one per metric, line per GPU)
    many nodes          -> one panel per NODE, a line per GPU, of a single metric
  A single --metric collapses to one panel. Narrow huge jobs with --node/--gpu."""
  console = Console(no_color=args.no_color)
  mcols = [c for c in metric_cols(columns) if is_pct(c) or c in ("POWER_W",)]
  if args.all:
    metrics = mcols
  elif args.metric:
    metrics = [m for m in args.metric.split(",") if m in columns] or die("none of --metric in CSV")
  else:
    metrics = [m for m in TS_DEFAULT if m in columns] or mcols[:4]

  # group samples by (node, gpu), time-ordered, against a common t0
  t0 = min((to_float(r.get("EPOCH")) for r in rows if to_float(r.get("EPOCH")) is not None), default=None)
  gpus = {}
  for r in rows:
    ep = to_float(r.get("EPOCH"))
    if ep is None:
      continue
    gpus.setdefault((r.get("NODE", "?"), r.get("GPU", "?")), []).append((ep, r))
  if not gpus or t0 is None:
    die("no timestamped samples (need --dcgm --ts --csv output)")
  for s in gpus.values():
    s.sort(key=lambda x: x[0])
  keys = sorted(gpus)
  nodes = sorted({n for n, _ in keys})
  jid = rows[0].get("JOBID", "?")
  running = any(r.get("STATE", "") == "RUNNING" for r in rows)
  base = args.title or ("job %s  DCGM over time%s" % (jid, "  (running)" if running else ""))
  mcolor = {m: PALETTE[i % len(PALETTE)] for i, m in enumerate(metrics)}
  gpu_ids = sorted({g for _, g in keys}, key=lambda g: int(g) if str(g).isdigit() else g)
  gcolor = {g: PALETTE[i % len(PALETTE)] for i, g in enumerate(gpu_ids)}  # GPU color, stable across panels

  def pkw(c):
    kw = {"marker": args.marker}            # thin braille lines by default (--marker)
    if not args.no_color:
      kw["color"] = c
    return kw

  def series(samples, m):
    """(xs minutes, ys) for metric m, dropping missing samples; (None, None) if empty."""
    xs, ys = [], []
    for ep, r in samples:
      v = to_float(r.get(m))
      if v is not None:
        xs.append((ep - t0) / 60.0); ys.append(v)
    return (xs, ys) if ys else (None, None)

  def cap(items, what):
    if len(items) > PANEL_CAP:
      print("note: showing %d of %d %s; narrow with --metric/--node/--gpu" % (PANEL_CAP, len(items), what),
            file=sys.stderr)
    return items[:PANEL_CAP]

  W = args.width or shutil.get_terminal_size((100, 30)).columns

  def figure(specs, title, ylabel, h):
    """Render ONE chart as its own plotext figure (independent height, so stacked
    panels never starve each other -- plt.subplots divides one terminal-bounded
    figure and silently drops overflow panels). Panels print in sequence."""
    plt.clear_figure(); plt.theme("clear"); plt.plotsize(W, h)
    for lbl, col, samp, m in specs:
      xs, ys = series(samp, m)
      if ys:
        plt.plot(xs, ys, label=lbl, **pkw(col))
    plt.title(title); plt.xlabel("minutes since start"); plt.ylabel(ylabel)
    plt.show(); print()

  if args.compact:
    # one braille sparkline row per (gpu,) metric, each scaled to its own min-max
    multi = len(keys) > 1
    def lab(n, g, m):
      return ("%s gpu%s %-8s" % (n, g, m)) if multi else ("%-8s" % m)
    labw = max((len(lab(n, g, m)) for n, g in keys for m in metrics), default=8)
    sc = max(12, W - labw - 30)
    print(base)
    for n, g in keys:
      for m in metrics:
        _, ys = series(gpus[(n, g)], m)
        if not ys:
          continue
        sp, lo, hi = braille_spark(ys, sc)
        text = "  %-*s ┤%s  (%g-%g, mean %.1f)" % (labw, lab(n, g, m), sp, lo, hi, sum(ys) / len(ys))
        console.print(text, style="color(%d)" % mcolor[m], markup=False, highlight=False)
    return

  multinode = len(nodes) > 1
  K, M = len(keys), len(metrics)
  lines_are_gpus = False     # whether each line is a GPU (color/label by GPU) vs a metric
  stat_metrics = metrics

  if multinode:
    # MULTI-NODE: one panel per node, a line per GPU, of a single metric
    m = metrics[0]; stat_metrics = [m]; lines_are_gpus = True
    if M > 1:
      print("note: multi-node view charts one metric (%s); use --node NODE to see all metrics for a node"
            % m, file=sys.stderr)
    for node in cap(nodes, "nodes"):
      figure([("gpu%s" % g, gcolor[g], gpus[(node, g)], m) for g in gpu_ids if (node, g) in gpus],
             "%s  %s" % (node, m), m, args.height or 9)
  elif M == 1:
    # one metric: one panel, a line per GPU (single line if just one GPU)
    m = metrics[0]; stat_metrics = [m]; lines_are_gpus = K > 1
    if K > 1:
      figure([("gpu%s" % g, gcolor[g], gpus[(n, g)], m) for n, g in keys],
             "%s  --  %s" % (m, base), m, args.height or 15)
    else:
      figure([(m, mcolor[m], gpus[keys[0]], m)], base, m, args.height or 15)
  elif args.by == "gpu":
    # facet by GPU: one panel per GPU, all metrics in it (metrics share that panel's axis)
    for key in cap(keys, "GPUs"):
      figure([(m, mcolor[m], gpus[key], m) for m in metrics],
             "%s gpu%s" % key, "value", args.height or 10)
  else:
    # DEFAULT (--by metric): one panel per metric (own y-axis), a line per GPU within
    lines_are_gpus = K > 1
    for m in cap(metrics, "metrics"):
      if K > 1:
        figure([("gpu%s" % g, gcolor[g], gpus[(n, g)], m) for n, g in keys], m, m, args.height or 10)
      else:
        figure([(m, mcolor[m], gpus[keys[0]], m)], m, m, args.height or 10)

  # per-(node,GPU) stats for the charted metric(s) -- the numbers the chart doesn't label, tinted
  console.rule("min / mean / max / last", style="dim", characters="-")
  for key in keys:
    tag = ("%s gpu%s  " % key) if len(keys) > 1 else ""
    for m in stat_metrics:
      _, ys = series(gpus[key], m)
      if not ys:
        continue
      line = "  %s%-9s min %6.1f   mean %6.1f   max %6.1f   last %6.1f" % (
          tag, m, min(ys), sum(ys) / len(ys), max(ys), ys[-1])
      col = gcolor[key[1]] if lines_are_gpus else mcolor[m]
      console.print(line, style="color(%d)" % col, markup=False, highlight=False)


def main():
  ap = argparse.ArgumentParser(
      formatter_class=argparse.RawDescriptionHelpFormatter,
      description="Render kempner_jobstats --csv output as a terminal graph.\n"
                  "Pipe it in:  kempner_jobstats <view> --csv | jobstats_plot\n"
                  "Kinds: bars (gauges), hist (distribution), heat (jobs x metrics),\n"
                  "line (--dcgm --ts time series). 'auto' picks from the CSV columns.")
  ap.add_argument("file", nargs="?", help="CSV file (default: stdin)")
  ap.add_argument("-f", "--file", dest="file_opt", help="CSV file (alternative to the positional arg)")
  ap.add_argument("--kind", choices=["auto", "bars", "heat", "hist", "line"], default="auto",
                  help="chart type (default: auto-detect from the CSV columns)")
  ap.add_argument("--metric", help="metric column for hist (one) or line (comma-separated)")
  ap.add_argument("--node", help="plot only this node (where the CSV has a NODE column)")
  ap.add_argument("--gpu", help="plot only this GPU index (where the CSV has a GPU column)")
  ap.add_argument("--all", action="store_true", help="line: draw every metric, not just the default set")
  ap.add_argument("--marker", choices=["braille", "dot", "hd", "fhd"], default="braille",
                  help="line marker (default braille = thin lines; hd = thick blocks; dot = sparse)")
  ap.add_argument("--by", choices=["metric", "gpu"], default="gpu",
                  help="line: facet by 'gpu' (default; one panel per GPU, all metrics on a shared "
                       "axis) or 'metric' (one panel per metric, own y-axis -- avoids overlap when "
                       "metrics share a range; see also --compact)")
  ap.add_argument("--compact", action="store_true",
                  help="line: one braille sparkline row per metric (own scale + min-max), "
                       "instead of full-height panels")
  ap.add_argument("--title", help="override the chart title")
  ap.add_argument("--width", type=int, help="plot width in chars (plotext charts)")
  ap.add_argument("--height", type=int, help="plot height in chars (plotext charts)")
  ap.add_argument("--max-rows", dest="max_rows", type=int, default=HEAT_MAX_ROWS,
                  help="heatmap row cap (default %d)" % HEAT_MAX_ROWS)
  ap.add_argument("--no-color", action="store_true", help="disable color (also respects $NO_COLOR)")
  ap.add_argument("--config", action="store_true",
                  help="pull GPU/CPU red thresholds from the jobstats config module")
  args = ap.parse_args()
  if os.environ.get("NO_COLOR"):
    args.no_color = True

  path = args.file_opt or args.file
  if path:
    try:
      fobj = open(path, newline="")
    except OSError as e:
      die("cannot open %s: %s" % (path, e))
  else:
    if sys.stdin.isatty():
      die("no input -- pipe kempner_jobstats --csv in, or pass a CSV file.")
    fobj = sys.stdin

  if args.config:
    load_config_red()

  columns, rows = parse_csv(fobj)
  if not rows:
    die("no data rows in the CSV (empty selection?).")

  # optional --node / --gpu narrowing (where the CSV carries those columns)
  if args.node is not None:
    if "NODE" not in columns:
      print("note: --node ignored (no NODE column in this CSV)", file=sys.stderr)
    else:
      avail = sorted({r.get("NODE") for r in rows if r.get("NODE")})
      rows = [r for r in rows if r.get("NODE") == args.node]
      if not rows:
        die("no rows for node %r. Available: %s" % (args.node, ", ".join(avail)))
  if args.gpu is not None and rows:
    if "GPU" not in columns:
      print("note: --gpu ignored (no GPU column in this CSV)", file=sys.stderr)
    else:
      avail = sorted({str(r.get("GPU")) for r in rows if r.get("GPU") not in (None, "")})
      rows = [r for r in rows if str(r.get("GPU")) == str(args.gpu)]
      if not rows:
        die("no rows for GPU %r. Available: %s" % (args.gpu, ", ".join(avail)))

  kind = args.kind
  if kind == "auto":
    k = detect_kind(columns)
    kind = ("bars" if len(rows) == 1 else "hist") if k == "summary" else k

  # validate explicit kinds against the CSV shape
  if kind == "line" and not ("EPOCH" in columns and "TIME" in columns):
    die("--kind line needs a time series: kempner_jobstats --dcgm --ts --csv")
  if kind == "hist" and len(rows) == 1:
    print("note: histogram needs multiple jobs; showing bars instead", file=sys.stderr)
    kind = "bars"

  plt, Console, Table, Text = load_libs()
  if kind == "bars":
